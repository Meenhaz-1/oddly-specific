# Keep the real key in .env. Never expose it through a VITE_ variable.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_GENERATOR_MODEL=gpt-5.5
OPENAI_EVALUATOR_MODEL=gpt-5.4-mini

# Backend only. Use the project's current sb_secret_... key, never a publishable browser key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Vercel sets this automatically. Do not add it yourself or expose any of the
# server-only variables above with a VITE_ prefix.
# VERCEL=1
